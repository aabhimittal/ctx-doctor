{
  "name": "agentsmd-doctor",
  "version": "0.2.0",
  "description": "Tells you what your AGENTS.md costs per session, where it contradicts itself, and — with an ablation run — which of its rules actually change the model's behaviour.",
  "type": "module",
  "bin": {
    "agentsmd-doctor": "bin/cli.js",
    "ctx-doctor": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "selfcheck": "node bin/cli.js --fail-on warn"
  },
  "keywords": [
    "agents.md",
    "claude.md",
    "cursorrules",
    "copilot-instructions",
    "linter",
    "llm",
    "prompt",
    "context",
    "tokens",
    "ablation",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabhimittal/ctx-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/aabhimittal/ctx-doctor/issues"
  },
  "homepage": "https://github.com/aabhimittal/ctx-doctor#readme"
}
